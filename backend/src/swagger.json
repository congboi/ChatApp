{
  "openapi": "3.0.0",
  "info": {
    "title": "Chatapp API Documentation",
    "version": "1.0.0",
    "description": "API documentation for the ChatApp backend."
  },
  "servers": [
    {
      "url": "http://localhost:5001"
    }
  ],
  "paths": {
    "/api/auth/signup": {
      "post": {
        "tags": ["Auth"],
        "summary": "User Signup",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "firstName": { "type": "string" },
                  "lastName": { "type": "string" }
                },
                "required": ["username", "password", "email", "firstName", "lastName"]
              },
              "example": {
                "username": "user1",
                "password": "password123",
                "email": "user1@example.com",
                "firstName": "John",
                "lastName": "Doe"
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Successfully registered" },
          "400": { "description": "Invalid input" },
          "409": { "description": "Username already exists" }
        }
      }
    },
    "/api/auth/signin": {
      "post": {
        "tags": ["Auth"],
        "summary": "User Signin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["username", "password"]
              },
              "example": {
                "username": "user1",
                "password": "password123"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Successfully logged in" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/auth/signout": {
      "post": {
        "tags": ["Auth"],
        "summary": "User Signout",
        "responses": {
          "204": { "description": "Successfully logged out" }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh Access Token",
        "responses": {
          "200": { "description": "New access token generated" },
          "401": { "description": "No refresh token" },
          "403": { "description": "Invalid or expired refresh token" }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "tags": ["Users"],
        "summary": "Get Current User Info",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Current user data" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/users/test": {
      "get": {
        "tags": ["Users"],
        "summary": "Test Endpoint",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "204": { "description": "Success" }
        }
      }
    },
    "/api/friends/": {
      "get": {
        "tags": ["Friends"],
        "summary": "Get All Friends",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "List of friends" }
        }
      }
    },
    "/api/friends/requests": {
      "get": {
        "tags": ["Friends"],
        "summary": "Get Friend Requests",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "List of sent and received requests" }
        }
      }
    },
    "/api/friends/request": {
      "post": {
        "tags": ["Friends"],
        "summary": "Send Friend Request",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to": { "type": "string", "description": "Target user ID" },
                  "message": { "type": "string" }
                },
                "required": ["to"]
              },
              "example": {
                "to": "TARGET_USER_ID",
                "message": "Hello, let's be friends!"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Request sent" }
        }
      }
    },
    "/api/friends/request/{requestId}/accept": {
      "post": {
        "tags": ["Friends"],
        "summary": "Accept Friend Request",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Request accepted" }
        }
      }
    },
    "/api/friends/request/{requestId}/decline": {
      "post": {
        "tags": ["Friends"],
        "summary": "Decline Friend Request",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Request declined" }
        }
      }
    },
    "/api/messages/direct": {
      "post": {
        "tags": ["Messages"],
        "summary": "Send Direct Message",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "recipientId": { "type": "string" },
                  "content": { "type": "string" },
                  "conversationId": { "type": "string", "nullable": true }
                },
                "required": ["content"]
              },
              "example": {
                "recipientId": "RECIPIENT_USER_ID",
                "content": "Hi there!"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Message sent" }
        }
      }
    },
    "/api/messages/group": {
      "post": {
        "tags": ["Messages"],
        "summary": "Send Group Message",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ConversationId": { "type": "string", "description": "Note: Case sensitive field name" },
                  "content": { "type": "string" }
                },
                "required": ["ConversationId", "content"]
              },
              "example": {
                "ConversationId": "GROUP_CONVERSATION_ID",
                "content": "Hello group!"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Message sent" }
        }
      }
    },
    "/api/conversations/": {
      "get": {
        "tags": ["Conversations"],
        "summary": "Get All Conversations",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "List of conversations" }
        }
      },
      "post": {
        "tags": ["Conversations"],
        "summary": "Create Conversation",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "enum": ["direct", "group"] },
                  "name": { "type": "string", "description": "Only for group type" },
                  "memberIds": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["type", "memberIds"]
              },
              "example": {
                "type": "group",
                "name": "My New Group",
                "memberIds": ["USER_ID_1", "USER_ID_2"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Conversation created" }
        }
      }
    },
    "/api/conversations/{conversationId}/messages": {
      "get": {
        "tags": ["Conversations"],
        "summary": "Get Messages for Conversation",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 50 }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "List of messages" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}